<Application x:Class="Fsr4Gfx803.ControlCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0B0F16"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A26"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#172232"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF0FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA8BC"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#263448"/>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#26354A"/>
            <Setter Property="BorderBrush" Value="#36475F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0D1420"/>
            <Setter Property="BorderBrush" Value="#314258"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#101722"/>
            <Setter Property="Background" Value="#E8EDF5"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Application.Resources>
</Application>
